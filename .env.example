# Production site URL, used for canonical links, Open Graph/Twitter
# metadata, sitemap.xml and robots.txt. Falls back to localhost in dev.
# TODO(owner): confirm the production domain before launch.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Supabase — R7.2 lead capture & analytics backend (docs/patient-acquisition.md).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. NEVER prefix with NEXT_PUBLIC_. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of email addresses allowed to sign in to /admin.
ADMIN_ALLOWED_EMAILS=owner@example.com

# Optional exact origin override for local reset testing (http://localhost:3000).
# Production defaults to https://dralejandromolinaurologist.com. Vercel Preview
# uses its stable VERCEL_BRANCH_URL (falling back to VERCEL_URL), which must be
# added exactly to Supabase Redirect URLs.
# ADMIN_AUTH_ORIGIN=http://localhost:3000
# Optional dedicated server-only HMAC key (>=32 random bytes recommended).
# Falls back to existing SUPABASE_SERVICE_ROLE_KEY; never NEXT_PUBLIC_.
# ADMIN_RECOVERY_SECRET=
